# Copy once → .env.local.prod (gitignored). `npm run local` reads this file for
# both the Next.js app and local edge-function secrets. No other env copies.

# Supabase (required for quote form, admin, and gallery CMS)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Service role — local scripts only (seed-gallery). Never commit or expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# PostHog analytics (optional — analytics disabled if unset)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Customer login / account creation (optional — disabled unless set to true)
# NEXT_PUBLIC_CUSTOMER_AUTH_ENABLED=true

# Admin navbar + email gate (comma-separated).
# NEXT_PUBLIC_ADMIN_ALLOWED_EMAILS=you@example.com
# Server-side gate for local admin-auth (defaults to the NEXT_PUBLIC_ value above if unset):
# ADMIN_ALLOWED_EMAILS=you@example.com

# --- Local edge functions (`npm run local` syncs these into supabase/.env) ---
# Same Discord/Sheets/Resend values you use on the hosted project work locally.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=PokePatch <noreply@pokepatch.cards>
# ORDERS_SHEETS_WEBHOOK_URL=
# ORDERS_SHEETS_SECRET=
# ORDERS_SHEET_VIEW_URL=
# SHEETS_WEBHOOK_URL=
# SHEETS_SECRET=
# SHEET_VIEW_URL=
# POKEMON_TCG_API_KEY=
